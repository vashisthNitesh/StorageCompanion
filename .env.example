# SmartSpace environment configuration. Copy to .env for local development.
# Never commit a real .env: it is git-ignored.

# General
ENVIRONMENT=dev
SECRET_KEY=change-me-to-a-long-random-string
# Defaults to SECRET_KEY. Set explicitly in production and never change it:
# it derives the vault keys of accounts created with Google sign-in.
VAULT_KEY_SECRET=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Defaults to SQLite (backend/db.sqlite3) when unset.
# Production: a PostgreSQL URL, e.g. postgres://user:password@host/dbname
DATABASE_URL=

# Master admin, created/updated on every deploy by `manage.py create_master_admin`.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Google Sign-In (OAuth client ID of type "Web application").
# Add your site's origin (e.g. https://smartspacedata.com and http://localhost:5173)
# to "Authorized JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=

# SpaceByte storage (https://spacebyte.in/api-docs). Without a token, local development
# uses offline mock responses (files are not actually stored).
SPACEBYTE_BASE_URL=https://spacebyte.in/api/v1
SPACEBYTE_ACCESS_TOKEN=
SPACEBYTE_STORAGE_POOL_LIMIT_BYTES=1073741824000
SPACEBYTE_PARENT_FOLDER_ID=

# Razorpay. Checkout is disabled until real keys are set (use rzp_test_ keys locally).
DEFAULT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Invoice seller details. Without a GSTIN, invoices are issued as payment receipts.
BUSINESS_NAME=SmartSpace
BUSINESS_ADDRESS=
