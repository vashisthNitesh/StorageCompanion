# Environment configuration for SpeedCloud / CloudVault

# General
ENVIRONMENT=dev
SECRET_KEY=speedcloud-super-secret-dev-key-change-in-production
DEBUG=True
DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database (PostgreSQL)
DATABASE_URL=postgres://speedcloud:speedcloudpass@localhost:5432/speedcloud_db
# For Docker Compose dev: postgres://speedcloud:speedcloudpass@db:5432/speedcloud_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
# For Docker Compose: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage / Cloudflare R2 / MinIO
STORAGE_BACKEND=minio
# Switch to 'r2' in production:
# STORAGE_BACKEND=r2
S3_ENDPOINT_URL=http://localhost:9000
# For R2: https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=speedcloud-files
S3_REGION_NAME=auto
PRESIGNED_URL_TTL=900

# Payments (razorpay or stripe)
PAYMENT_PROVIDER=razorpay
DEFAULT_CURRENCY=INR

# Razorpay credentials (test mode)
RAZORPAY_KEY_ID=rzp_test_sample
RAZORPAY_KEY_SECRET=sample_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# Stripe credentials (alternative)
STRIPE_PUBLISHABLE_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=SpeedCloud <noreply@speedcloud.local>
